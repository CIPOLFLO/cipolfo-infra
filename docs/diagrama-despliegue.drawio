  <diagram name="Capas de seguridad" id="seguridad-cipolflo">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="500" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="titulo" value="Security Groups: cada capa solo acepta conexiones de la anterior" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="700" height="30" as="geometry" />
        </mxCell>

        <mxCell id="net" value="Internet&lt;br&gt;0.0.0.0/0" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="150" width="180" height="80" as="geometry" />
        </mxCell>
        <mxCell id="sgalb" value="&lt;b&gt;SG del ALB&lt;/b&gt;&lt;br&gt;balanceador" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="400" y="150" width="200" height="80" as="geometry" />
        </mxCell>
        <mxCell id="sgecs" value="&lt;b&gt;SG de los contenedores&lt;/b&gt;&lt;br&gt;frontend y backend" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="780" y="150" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="sgrds" value="&lt;b&gt;SG de la base&lt;/b&gt;&lt;br&gt;RDS PostgreSQL" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="1180" y="150" width="180" height="80" as="geometry" />
        </mxCell>

        <mxCell id="s1" value="TCP 80 y 443&lt;br&gt;unico ingreso desde internet" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="net" target="sgalb">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s2" value="cualquier puerto, pero&lt;br&gt;solo desde el SG del ALB" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="sgalb" target="sgecs">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s3" value="TCP 5432, solo desde&lt;br&gt;el SG de los contenedores" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="sgecs" target="sgrds">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="nota" value="Leido al reves: a la base solo le puede hablar un contenedor, y a un contenedor solo le puede hablar el ALB.&lt;br&gt;El SG de la base no tiene reglas de salida; los otros dos si, y es lo que les permite bajar la imagen de ECR y llamar a los servicios externos." style="text;html=1;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="310" width="1320" height="60" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
